---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../data/site";
import { projetsRecents } from "../data/projects";

// Les 2 projets les plus récents (triés par date de début)
const latest = projetsRecents.slice(0, 2);
---

<Base title={`${site.name} — Portfolio`} description={site.seo.description}>

  <!-- HERO -->
  <section class="hero" aria-label="Introduction">
    <div class="heroLeft">
      <!-- Remplacer par : <img src="/me.jpg" alt="Photo de Mattéo" class="portrait" loading="eager" /> -->
      <div class="portrait-placeholder" role="img" aria-label="Photo de profil">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".4">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        <span>Ajouter <code>public/me.jpg</code></span>
      </div>
    </div>

    <div class="heroRight">
      <h1 class="headline">Bonjour, je suis {site.name}.</h1>
      <p class="lead">
        Étudiant en 3e année d'ingénierie microtechnique à HEPIA (HES-SO Genève),
        spécialisation biomédicale.
      </p>
      <p class="lead">
        Électronique embarquée, impression 3D, systèmes embarqués — du banc de labo au
        prototype fonctionnel.
      </p>
      <div class="ctaRow">
        <a class="btn btn-primary" href="/projects">Projets</a>
        <a class="btn" href="/about">À propos</a>
        <a class="btn" href="/contact">Contact</a>
        <a class="btn btn-cv" href={site.cv} download>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Télécharger mon CV
        </a>
      </div>
    </div>
  </section>

  <!-- LATEST PROJECTS -->
  <section aria-label="Derniers projets">
    <div class="section-head">
      <h2>Derniers projets</h2>
      <a class="see-all" href="/projects">Tous les projets →</a>
    </div>
    <div class="projectsGrid">
      {latest.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

</Base>
