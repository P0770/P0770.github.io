---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Img from "../components/Img.astro";
import { site } from "../data/site";
import { projetsRecents } from "../data/projects";

// Projets mis en avant : ceux marqués « vedette: true » dans src/data/projects.ts
// (du plus récent au plus ancien). S'il n'y en a aucun, les 2 plus récents.
const vedettes = projetsRecents.filter((p) => p.vedette);
const latest = vedettes.length > 0 ? vedettes : projetsRecents.slice(0, 2);
---

<Base title={`${site.name} — Portfolio`} description={site.seo.description}>

  <!-- HERO -->
  <section class="hero" aria-label="Introduction">
    <div class="heroLeft">
      <Img
        src="/me.jpg"
        alt="Mattéo Pozzo di Borgo à son poste de soudure"
        class="portrait"
        sizes="(max-width: 900px) 240px, 380px"
        loading="eager"
        fallback={false}
      />
    </div>

    <div class="heroRight">
      <h1 class="headline">Bonjour, je suis {site.name}.</h1>
      <p class="lead">
        Étudiant en 3e année d'ingénierie microtechnique à HEPIA (HES-SO Genève),
        spécialisation biomédicale.
      </p>
      <p class="lead">
        J'aime concevoir des objets complets : l'électronique, le code embarqué et les
        pièces imprimées en 3D, jusqu'à ce que ça fonctionne vraiment.
      </p>
      <div class="ctaRow">
        <a class="btn btn-primary" href="/projects">Projets</a>
        <a class="btn" href="/about">À propos</a>
        <a class="btn" href="/contact">Contact</a>
        <a class="btn btn-cv" href={site.cv} download>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Télécharger mon CV
        </a>
      </div>
    </div>
  </section>

  <!-- PROJETS MIS EN AVANT -->
  <section aria-label="Projets phares">
    <div class="section-head">
      <h2>Projets phares</h2>
      <a class="see-all" href="/projects">Tous les projets →</a>
    </div>
    <div class="projectsGrid">
      {latest.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

</Base>
