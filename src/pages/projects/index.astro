---
import Base from "../../layouts/Base.astro";
import Timeline from "../../components/Timeline.astro";
import { site } from "../../data/site";
---

<Base
  title={`Projets — ${site.name}`}
  description="Tous les projets de Mattéo Pozzo di Borgo, dans l'ordre chronologique — électronique, systèmes embarqués, impression 3D, automatisme."
>
  <section class="pageHead">
    <h1>Projets</h1>
    <p class="lead">
      Mon parcours en projets, du plus ancien à aujourd'hui — personnels et académiques,
      de l'idée au prototype fonctionnel.
    </p>
  </section>

  <Timeline />
</Base>
