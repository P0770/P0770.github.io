---
import Projet from "../../views/Projet.astro";
import { projetsDe } from "../../data/donnees";
import type { Project } from "../../data/projects";

export function getStaticPaths() {
  return projetsDe("fr").map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
---
<Projet project={project} />
