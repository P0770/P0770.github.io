---
import Base from "../../layouts/Base.astro";
import { site } from "../../data/site";
import { projects, projetsRecents, getProject, type Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props:  { project },
  }));
}

const { project } = Astro.props as { project: Project };
const coverSrc = project.cover?.src ?? "/projects/placeholder.svg";
const coverAlt = project.cover?.alt ?? project.title;
const gallery  = project.gallery ?? [];
const hasGallery    = gallery.length > 0;
const hasHighlights = (project.highlights?.length ?? 0) > 0;

// En-tête : seules les lignes renseignées sont affichées
const infos = [
  { label: "Période", value: project.periode },
  { label: "Cadre",   value: project.cadre },
  { label: "Équipe",  value: project.equipe },
  { label: "Rôle",    value: project.role },
  { label: "Budget",  value: project.budget },
  { label: "Statut",  value: project.statut },
].filter((i) => i.value);

// Navigation dans l'ordre de la chronologie (du plus récent au plus ancien)
const index      = projetsRecents.findIndex((p) => p.slug === project.slug);
const plusRecent = index > 0 ? projetsRecents[index - 1] : undefined;
const plusAncien = index < projetsRecents.length - 1 ? projetsRecents[index + 1] : undefined;

const related = (project.related ?? [])
  .map((s) => getProject(s))
  .filter((p): p is Project => Boolean(p));
---

<Base title={`${project.title} — ${site.name}`} description={project.subtitle}>

  <div class="backRow">
    <a class="backLink" href="/projects">← Chronologie des projets</a>
  </div>

  <header class="projectHead">
    {project.enCours && (
      <div class="projectHeadTop">
        <span class="badge-live">En cours</span>
      </div>
    )}
    <h1>{project.title}</h1>
    <p class="lead">{project.subtitle}</p>

    <dl class="projectInfos">
      {infos.map((i) => (
        <div class="projectInfo">
          <dt>{i.label}</dt>
          <dd>{i.value}</dd>
        </div>
      ))}
    </dl>

    <div class="chips" style="margin-top:1rem;">
      {project.tags.map((t) => <span class="chip">{t}</span>)}
    </div>

    {project.links && project.links.length > 0 && (
      <div style="margin-top:.9rem; display:flex; gap:.6rem; flex-wrap:wrap;">
        {project.links.map((l) => (
          <a
            href={l.href}
            target="_blank"
            rel="noreferrer"
            style="font-size:.85rem; color:var(--accent); text-decoration:underline; text-underline-offset:3px;"
          >
            {l.label} ↗
          </a>
        ))}
      </div>
    )}
  </header>

  <figure class="heroMedia">
    <img
      src={coverSrc}
      alt={coverAlt}
      loading="eager"
      onerror="this.onerror=null;this.src='/projects/placeholder.svg'"
    />
    {project.cover?.caption ? <figcaption>{project.cover.caption}</figcaption> : null}
  </figure>

  {hasHighlights && (
    <section class="highlights" aria-label="Points clés">
      <h2>Points clés</h2>
      <ul>
        {project.highlights!.map((h) => <li>{h}</li>)}
      </ul>
    </section>
  )}

  {hasGallery && (
    <section class="gallery" aria-label="Galerie">
      <h2>Galerie</h2>
      <div class="galleryGrid">
        {gallery.map((m) =>
          m.type === "video" ? (
            <div class="gallery-item gallery-video">
              <video src={`${m.src}#t=0.1`} controls preload="metadata" playsinline aria-label={m.alt}></video>
              {m.caption && <p class="gallery-caption">{m.caption}</p>}
            </div>
          ) : (
            <div class="gallery-item" data-lb role="button" tabindex="0" aria-label={`Agrandir : ${m.alt}`}>
              <img
                src={m.src}
                alt={m.alt}
                loading="lazy"
                onerror="this.onerror=null;this.src='/projects/placeholder.svg'"
              />
              {m.caption && <p class="gallery-caption">{m.caption}</p>}
            </div>
          )
        )}
      </div>
    </section>
  )}

  <div class="content">
    {project.sections.map((s) => (
      <article class="contentBlock">
        <h2>{s.heading}</h2>
        {s.paragraphs?.map((p) => <p>{p}</p>)}
        {s.bullets?.length ? (
          <ul>
            {s.bullets.map((b) => <li>{b}</li>)}
          </ul>
        ) : null}
      </article>
    ))}
  </div>

  {related.length > 0 && (
    <section class="related" aria-label="Projets liés">
      <h2>Projets liés</h2>
      <div class="chips">
        {related.map((p) => (
          <a class="chip chip-link" href={`/projects/${p.slug}`}>{p.title} →</a>
        ))}
      </div>
    </section>
  )}

  <nav class="projectNav" aria-label="Autres projets">
    {plusRecent ? (
      <a class="projectNavLink" href={`/projects/${plusRecent.slug}`}>
        <span class="projectNavLabel">← Plus récent</span>
        <span class="projectNavTitle">{plusRecent.title}</span>
      </a>
    ) : <span></span>}
    {plusAncien ? (
      <a class="projectNavLink projectNavNext" href={`/projects/${plusAncien.slug}`}>
        <span class="projectNavLabel">Plus ancien →</span>
        <span class="projectNavTitle">{plusAncien.title}</span>
      </a>
    ) : <span></span>}
  </nav>

</Base>

<!-- Lightbox -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Vue agrandie">
  <div class="lb-inner">
    <img class="lb-img" src="" alt="" />
    <p class="lb-caption"></p>
  </div>
  <button class="lb-close" aria-label="Fermer">×</button>
  <button class="lb-prev" aria-label="Image précédente">‹</button>
  <button class="lb-next" aria-label="Image suivante">›</button>
</div>

<script is:inline>
  (function () {
    const items   = document.querySelectorAll(".gallery-item[data-lb]");
    const lb      = document.getElementById("lightbox");
    const lbImg   = lb.querySelector(".lb-img");
    const lbCap   = lb.querySelector(".lb-caption");
    let cur = 0;

    function open(i) {
      cur = i;
      const item = items[i];
      lbImg.src = item.querySelector("img").src;
      lbImg.alt = item.querySelector("img").alt;
      const cap = item.querySelector(".gallery-caption");
      lbCap.textContent = cap ? cap.textContent : "";
      lb.classList.add("open");
      document.body.style.overflow = "hidden";
    }
    function close() {
      lb.classList.remove("open");
      document.body.style.overflow = "";
    }
    function prev() { open((cur - 1 + items.length) % items.length); }
    function next() { open((cur + 1) % items.length); }

    items.forEach((item, i) => {
      item.addEventListener("click", () => open(i));
      item.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") open(i); });
    });
    lb.querySelector(".lb-close").addEventListener("click", close);
    lb.querySelector(".lb-prev").addEventListener("click", prev);
    lb.querySelector(".lb-next").addEventListener("click", next);
    lb.addEventListener("click", (e) => { if (e.target === lb) close(); });

    // ── Balayage au doigt (téléphone) ──
    // Gauche → image suivante, droite → précédente, vers le bas → fermer.
    let x0 = null, y0 = null;
    lb.addEventListener("touchstart", (e) => {
      if (e.touches.length !== 1) { x0 = null; return; }
      x0 = e.touches[0].clientX;
      y0 = e.touches[0].clientY;
    }, { passive: true });
    lb.addEventListener("touchend", (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      x0 = y0 = null;
      const SEUIL = 50; // px minimum pour compter comme un balayage
      if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > SEUIL) {
        if (items.length > 1) (dx < 0 ? next : prev)();
      } else if (dy > 90 && Math.abs(dy) > Math.abs(dx)) {
        close();
      }
    }, { passive: true });
    document.addEventListener("keydown", (e) => {
      if (!lb.classList.contains("open")) return;
      if (e.key === "Escape")     close();
      if (e.key === "ArrowLeft")  prev();
      if (e.key === "ArrowRight") next();
    });
  })();
</script>
