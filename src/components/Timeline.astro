---
import ProjectCard from "./ProjectCard.astro";
import type { Project } from "../data/projects";
import { chronologiques, timelineDe } from "../data/donnees";
import { typeProjet } from "../lib/typeProjet";
import { t, langDe, lien } from "../i18n/ui";

const lang = langDe(Astro.url.pathname);
const T = t(lang);
const projetsChronologiques = chronologiques(lang);
const { jalons, avant, formationParAnnee } = timelineDe(lang);

type Evenement =
  | { kind: "jalon"; cle: string; quand: string; titre: string; detail?: string }
  | { kind: "projet"; cle: string; project: Project; cote: "left" | "right" };

// 1. Tous les événements (jalons + projets) avec une clé de tri.
//    Ordre antichronologique : du plus récent (en haut) au plus ancien (en bas).
const bruts: Evenement[] = [
  ...jalons.map((j) => ({
    kind: "jalon" as const,
    cle: `${j.date}|0|${j.date}`,
    quand: j.quand,
    titre: j.titre,
    detail: j.detail,
  })),
  ...projetsChronologiques.map((p) => ({
    kind: "projet" as const,
    cle: `${p.debut}|1|${p.fin ?? p.debut}`,
    project: p,
    cote: "left" as const,
  })),
].sort((a, b) => b.cle.localeCompare(a.cle));

// 2. Côté de la carte : projets d'école à gauche, projets perso à droite.
for (const ev of bruts) {
  if (ev.kind === "projet") ev.cote = typeProjet(ev.project, lang).kind === "ecole" ? "left" : "right";
}

// 3. Regroupement par année civile (2026, 2025, …).
const annees: { annee: string; evenements: Evenement[] }[] = [];
for (const ev of bruts) {
  const annee = ev.cle.slice(0, 4);
  let groupe = annees.find((g) => g.annee === annee);
  if (!groupe) annees.push((groupe = { annee, evenements: [] }));
  groupe.evenements.push(ev);
}

const enCours = projetsChronologiques.filter((p) => p.enCours);
---

<section class="tl" data-tl aria-label={T.tlAria}>
  <div class="tl-colonnes" aria-hidden="true">
    <span class="typeBadge typeBadge--ecole"><span class="typeBadge-mark"></span>{T.colonneEcole}</span>
    <span class="typeBadge typeBadge--perso"><span class="typeBadge-mark"></span>{T.colonnePerso}</span>
  </div>
  <div class="tl-body" data-tl-body>
    <div class="tl-axis" data-tl-axis aria-hidden="true">
      <div class="tl-axisFill" data-tl-fill></div>
    </div>

    <div class="tl-today tl-reveal" data-tl-today>
      <span class="tl-todayDot" data-tl-today-dot aria-hidden="true"></span>
      <span class="tl-todayLabel">{T.aujourdhui}</span>
      {enCours.length > 0 && (
        <p class="tl-todayList">
          {T.toujoursEnCours}{" "}
          {enCours.map((p, k) => (
            <>
              <a href={lien(lang, `/projects/${p.slug}`)}>{p.title}</a>
              {k < enCours.length - 1 && <span class="dot"> · </span>}
            </>
          ))}
        </p>
      )}
    </div>

    {annees.map((g) => (
      <div class="tl-year">
        <div class="tl-yearHead tl-reveal">
          <span class="tl-yearNum">{g.annee}</span>
          {formationParAnnee[g.annee] && (
            <span class="tl-yearCtx">
              {formationParAnnee[g.annee].split(" · ").map((morceau, i) => (
                <>
                  {i > 0 && " · "}
                  <span class="tl-yearCtxPart">{morceau}</span>
                </>
              ))}
            </span>
          )}
        </div>

        <ol class="tl-list">
          {g.evenements.map((ev) =>
            ev.kind === "jalon" ? (
              <li class="tl-jalon tl-reveal">
                <span class="tl-jalonDot" aria-hidden="true"></span>
                <div class="tl-jalonText">
                  <span class="tl-when">{ev.quand}</span>
                  <span class="tl-jalonTitle">{ev.titre}</span>
                  {ev.detail && <span class="tl-jalonDetail">{ev.detail}</span>}
                </div>
              </li>
            ) : (
              <li
                class:list={[
                  "tl-item",
                  "tl-reveal",
                  `tl-${ev.cote}`,
                  { "tl-ongoing": ev.project.enCours },
                ]}
              >
                <span class="tl-dot" data-tl-dot={ev.project.enCours ? "ongoing" : undefined} aria-hidden="true"></span>
                <div class="tl-card">
                  <ProjectCard project={ev.project} variant="timeline" />
                </div>
              </li>
            )
          )}
        </ol>
      </div>
    ))}

  </div>

  <p class="tl-avant">
    <span class="tl-avantLabel">{T.avant}</span>
    <span>{avant}</span>
  </p>
</section>

<script>
  const tl = document.querySelector<HTMLElement>("[data-tl]");
  if (tl) {
    const body  = tl.querySelector<HTMLElement>("[data-tl-body]")!;
    const axis  = tl.querySelector<HTMLElement>("[data-tl-axis]")!;
    const fill  = tl.querySelector<HTMLElement>("[data-tl-fill]")!;
    const todayDot = tl.querySelector<HTMLElement>("[data-tl-today-dot]")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    tl.classList.add("tl-js");

    // ── Apparition au défilement ──
    const reveals = tl.querySelectorAll<HTMLElement>(".tl-reveal");
    if (reduce || !("IntersectionObserver" in window)) {
      reveals.forEach((el) => el.classList.add("is-visible"));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
      );
      reveals.forEach((el) => io.observe(el));
    }

    // ── Position verticale (dans .tl-body) du centre d'un point ──
    // offsetTop ignore les transformations CSS : les animations ne faussent pas le calcul.
    const centreY = (el: HTMLElement) => {
      let y = el.offsetHeight / 2;
      let n: HTMLElement | null = el;
      while (n && n !== body) {
        y += n.offsetTop;
        n = n.offsetParent as HTMLElement | null;
      }
      return y;
    };

    // ── Pointillés des projets en cours jusqu'à « Aujourd'hui » ──
    const dots = Array.from(tl.querySelectorAll<HTMLElement>('[data-tl-dot="ongoing"]'));
    const trails = dots.map(() => {
      const t = document.createElement("div");
      t.className = "tl-trail";
      t.setAttribute("aria-hidden", "true");
      body.appendChild(t);
      return t;
    });

    const placerTrails = () => {
      // « Aujourd'hui » est en haut : le pointillé remonte du point du projet jusqu'à lui.
      const haut = centreY(todayDot);
      const x = axis.offsetLeft + axis.offsetWidth / 2;
      // Sur téléphone, les pointillés se superposent en une seule ligne discrète
      const pas = window.matchMedia("(max-width: 640px)").matches ? 0 : 5;
      dots.forEach((d, k) => {
        const bas = centreY(d);
        const t = trails[k];
        t.style.top = `${haut}px`;
        t.style.height = `${Math.max(0, bas - haut)}px`;
        t.style.left = `${x + 6 + k * pas}px`;
      });
    };

    // ── Piste de circuit imprimé ──
    // La ligne centrale est une piste en zigzag : à chaque projet, elle bifurque à 45°
    // vers sa carte (gauche = école, droite = perso), passe par un « via », puis revient.
    const NS = "http://www.w3.org/2000/svg";
    const svg = document.createElementNS(NS, "svg");
    svg.setAttribute("class", "tl-piste");
    svg.setAttribute("aria-hidden", "true");
    body.prepend(svg);
    const base = document.createElementNS(NS, "path");
    base.setAttribute("class", "tl-piste-base");
    const cuivre = document.createElementNS(NS, "path");
    cuivre.setAttribute("class", "tl-piste-cuivre");
    const vias = document.createElementNS(NS, "g");
    svg.append(base, cuivre, vias);
    let longueur = 0;

    const tracer = () => {
      const W = body.offsetWidth, H = body.offsetHeight;
      svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
      svg.setAttribute("width", String(W));
      svg.setAttribute("height", String(H));
      const mobile = window.matchMedia("(max-width: 860px)").matches;
      const cx = axis.offsetLeft + axis.offsetWidth / 2;
      const J = mobile ? 13 : 24;           // amplitude de la bifurcation
      const y0 = centreY(todayDot);
      let d = `M${cx},${y0}`;
      vias.replaceChildren();
      const items = Array.from(tl.querySelectorAll<HTMLElement>(".tl-item"));
      items.forEach((it, k) => {
        const dot = it.querySelector<HTMLElement>(".tl-dot")!;
        const y = centreY(dot);
        const s = mobile || it.classList.contains("tl-right") ? 1 : -1;
        // Variation légère, pour un tracé moins mécanique
        const j = J + (k % 3) * (mobile ? 2 : 5);
        const xv = cx + s * j;
        d += ` V${y - j} L${xv},${y} L${cx},${y + j}`;
        // Via et liaison vers la carte
        const card = it.querySelector<HTMLElement>(".tl-card")!;
        const r = card.getBoundingClientRect(), b = body.getBoundingClientRect();
        const xCarte = s > 0 ? r.left - b.left : r.right - b.left;
        const stub = document.createElementNS(NS, "path");
        stub.setAttribute("class", "tl-piste-stub");
        stub.setAttribute("d", `M${xv},${y} H${xCarte}`);
        const via = document.createElementNS(NS, "circle");
        via.setAttribute("cx", String(xv));
        via.setAttribute("cy", String(y));
        via.setAttribute("r", mobile ? "5" : "6.5");
        via.setAttribute("class", it.classList.contains("tl-ongoing") ? "tl-via tl-via--encours" : "tl-via");
        vias.append(stub, via);
      });
      d += ` V${H - 16}`;
      base.setAttribute("d", d);
      cuivre.setAttribute("d", d);
      longueur = cuivre.getTotalLength();
      cuivre.style.strokeDasharray = `${longueur}`;
      remplir();
    };

    // ── Remplissage de la piste au défilement ──
    const remplir = () => {
      const r = body.getBoundingClientRect();
      const repere = window.innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (repere - r.top) / r.height));
      fill.style.height = `${p * 100}%`;
      if (longueur) cuivre.style.strokeDashoffset = `${longueur * (1 - p)}`;
    };

    let raf = 0;
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        remplir();
      });
    };

    const toutRecalculer = () => {
      placerTrails();
      tracer();
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", toutRecalculer);
    window.addEventListener("load", toutRecalculer);
    tl.querySelectorAll("img").forEach((img) =>
      img.addEventListener("load", toutRecalculer, { once: true })
    );
    toutRecalculer();
  }
</script>
