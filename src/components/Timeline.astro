---
import ProjectCard from "./ProjectCard.astro";
import { projetsChronologiques, type Project } from "../data/projects";
import { jalons, avant, formationParAnnee } from "../data/timeline";

type Evenement =
  | { kind: "jalon"; cle: string; quand: string; titre: string; detail?: string }
  | { kind: "projet"; cle: string; project: Project; cote: "left" | "right" };

// 1. Tous les événements (jalons + projets) avec une clé de tri.
//    Ordre antichronologique : du plus récent (en haut) au plus ancien (en bas).
const bruts: Evenement[] = [
  ...jalons.map((j) => ({
    kind: "jalon" as const,
    cle: `${j.date}|0|${j.date}`,
    quand: j.quand,
    titre: j.titre,
    detail: j.detail,
  })),
  ...projetsChronologiques.map((p) => ({
    kind: "projet" as const,
    cle: `${p.debut}|1|${p.fin ?? p.debut}`,
    project: p,
    cote: "left" as const,
  })),
].sort((a, b) => b.cle.localeCompare(a.cle));

// 2. Alternance gauche / droite des cartes projet.
let i = 0;
for (const ev of bruts) {
  if (ev.kind === "projet") ev.cote = i++ % 2 === 0 ? "left" : "right";
}

// 3. Regroupement par année civile (2026, 2025, …).
const annees: { annee: string; evenements: Evenement[] }[] = [];
for (const ev of bruts) {
  const annee = ev.cle.slice(0, 4);
  let groupe = annees.find((g) => g.annee === annee);
  if (!groupe) annees.push((groupe = { annee, evenements: [] }));
  groupe.evenements.push(ev);
}

const enCours = projetsChronologiques.filter((p) => p.enCours);
---

<section class="tl" data-tl aria-label="Chronologie des projets">
  <div class="tl-body" data-tl-body>
    <div class="tl-axis" data-tl-axis aria-hidden="true">
      <div class="tl-axisFill" data-tl-fill></div>
    </div>

    <div class="tl-today tl-reveal" data-tl-today>
      <span class="tl-todayDot" data-tl-today-dot aria-hidden="true"></span>
      <span class="tl-todayLabel">Aujourd'hui</span>
      {enCours.length > 0 && (
        <p class="tl-todayList">
          Toujours en cours :{" "}
          {enCours.map((p, k) => (
            <>
              <a href={`/projects/${p.slug}`}>{p.title}</a>
              {k < enCours.length - 1 && <span class="dot"> · </span>}
            </>
          ))}
        </p>
      )}
    </div>

    {annees.map((g) => (
      <div class="tl-year">
        <div class="tl-yearHead tl-reveal">
          <span class="tl-yearNum">{g.annee}</span>
          {formationParAnnee[g.annee] && (
            <span class="tl-yearCtx">{formationParAnnee[g.annee]}</span>
          )}
        </div>

        <ol class="tl-list">
          {g.evenements.map((ev) =>
            ev.kind === "jalon" ? (
              <li class="tl-jalon tl-reveal">
                <span class="tl-jalonDot" aria-hidden="true"></span>
                <div class="tl-jalonText">
                  <span class="tl-when">{ev.quand}</span>
                  <span class="tl-jalonTitle">{ev.titre}</span>
                  {ev.detail && <span class="tl-jalonDetail">{ev.detail}</span>}
                </div>
              </li>
            ) : (
              <li
                class:list={[
                  "tl-item",
                  "tl-reveal",
                  `tl-${ev.cote}`,
                  { "tl-ongoing": ev.project.enCours },
                ]}
              >
                <span class="tl-dot" data-tl-dot={ev.project.enCours ? "ongoing" : undefined} aria-hidden="true"></span>
                <div class="tl-card">
                  <ProjectCard project={ev.project} variant="timeline" />
                </div>
              </li>
            )
          )}
        </ol>
      </div>
    ))}

  </div>

  <p class="tl-avant">
    <span class="tl-avantLabel">Avant</span>
    <span>{avant}</span>
  </p>
</section>

<script>
  const tl = document.querySelector<HTMLElement>("[data-tl]");
  if (tl) {
    const body  = tl.querySelector<HTMLElement>("[data-tl-body]")!;
    const axis  = tl.querySelector<HTMLElement>("[data-tl-axis]")!;
    const fill  = tl.querySelector<HTMLElement>("[data-tl-fill]")!;
    const todayDot = tl.querySelector<HTMLElement>("[data-tl-today-dot]")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    tl.classList.add("tl-js");

    // ── Apparition au défilement ──
    const reveals = tl.querySelectorAll<HTMLElement>(".tl-reveal");
    if (reduce || !("IntersectionObserver" in window)) {
      reveals.forEach((el) => el.classList.add("is-visible"));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
      );
      reveals.forEach((el) => io.observe(el));
    }

    // ── Position verticale (dans .tl-body) du centre d'un point ──
    // offsetTop ignore les transformations CSS : les animations ne faussent pas le calcul.
    const centreY = (el: HTMLElement) => {
      let y = el.offsetHeight / 2;
      let n: HTMLElement | null = el;
      while (n && n !== body) {
        y += n.offsetTop;
        n = n.offsetParent as HTMLElement | null;
      }
      return y;
    };

    // ── Pointillés des projets en cours jusqu'à « Aujourd'hui » ──
    const dots = Array.from(tl.querySelectorAll<HTMLElement>('[data-tl-dot="ongoing"]'));
    const trails = dots.map(() => {
      const t = document.createElement("div");
      t.className = "tl-trail";
      t.setAttribute("aria-hidden", "true");
      body.appendChild(t);
      return t;
    });

    const placerTrails = () => {
      // « Aujourd'hui » est en haut : le pointillé remonte du point du projet jusqu'à lui.
      const haut = centreY(todayDot);
      const x = axis.offsetLeft + axis.offsetWidth / 2;
      dots.forEach((d, k) => {
        const bas = centreY(d);
        const t = trails[k];
        t.style.top = `${haut}px`;
        t.style.height = `${Math.max(0, bas - haut)}px`;
        t.style.left = `${x + 6 + k * 5}px`;
      });
    };

    // ── Remplissage de la ligne au défilement ──
    const remplir = () => {
      const r = body.getBoundingClientRect();
      const repere = window.innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (repere - r.top) / r.height));
      fill.style.height = `${p * 100}%`;
    };

    let raf = 0;
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        remplir();
      });
    };

    const toutRecalculer = () => {
      placerTrails();
      remplir();
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", toutRecalculer);
    window.addEventListener("load", toutRecalculer);
    tl.querySelectorAll("img").forEach((img) =>
      img.addEventListener("load", placerTrails, { once: true })
    );
    toutRecalculer();
  }
</script>
