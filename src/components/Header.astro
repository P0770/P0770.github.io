---
import { site } from "../data/site";
const { currentPath = "/" } = Astro.props as { currentPath?: string };
const isHome     = currentPath === "/";
const isProjects = currentPath.startsWith("/projects");
const isAbout    = currentPath.startsWith("/about");
const isContact  = currentPath.startsWith("/contact");
---

<header class="topbar">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Accueil">
      <div class="brand-name">{site.name}</div>
      <div class="brand-sub">{site.headline}</div>
    </a>

    <nav class="nav" id="main-nav" aria-label="Navigation principale">
      <a href="/" class:list={{ active: isHome }} aria-current={isHome ? "page" : undefined}>Accueil</a>
      <a href="/projects" class:list={{ active: isProjects }} aria-current={isProjects ? "page" : undefined}>Projets</a>
      <a href="/about" class:list={{ active: isAbout }} aria-current={isAbout ? "page" : undefined}>À propos</a>
      <a href="/contact" class:list={{ active: isContact }} aria-current={isContact ? "page" : undefined}>Contact</a>
    </nav>

    <div class="actions">
      <button class="btn-icon" id="theme-toggle" aria-label="Changer de thème" title="Changer de thème">
        <!-- Soleil : affiché en mode sombre -->
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Lune : affiché en mode clair -->
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <a class="btn-ghost" href={`mailto:${site.email}`}>Email</a>
    </div>

    <button class="burger" id="menu-toggle" aria-expanded="false" aria-controls="main-nav" aria-label="Ouvrir le menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<script is:inline>
  // ── Thème ──
  const toggle = document.getElementById("theme-toggle");
  const html   = document.documentElement;
  toggle.addEventListener("click", () => {
    const dark = html.getAttribute("data-theme") === "dark" ||
      (!html.getAttribute("data-theme") && window.matchMedia("(prefers-color-scheme: dark)").matches);
    const next = dark ? "light" : "dark";
    html.setAttribute("data-theme", next);
    try { localStorage.setItem("theme", next); } catch(e) {}
  });

  // ── Menu mobile ──
  const burger = document.getElementById("menu-toggle");
  const nav    = document.getElementById("main-nav");
  burger.addEventListener("click", () => {
    const open = nav.classList.toggle("nav-open");
    burger.setAttribute("aria-expanded", String(open));
  });
  const fermerMenu = () => {
    nav.classList.remove("nav-open");
    burger.setAttribute("aria-expanded", "false");
  };
  document.addEventListener("click", (e) => {
    if (!burger.contains(e.target) && !nav.contains(e.target)) fermerMenu();
  });
  // Toucher un lien du menu le referme
  nav.querySelectorAll("a").forEach((a) => a.addEventListener("click", fermerMenu));
  // Touche Échap
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && nav.classList.contains("nav-open")) {
      fermerMenu();
      burger.focus();
    }
  });
</script>
