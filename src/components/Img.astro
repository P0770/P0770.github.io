---
// Image optimisée : sert une version WebP à la bonne taille selon l'écran,
// avec l'image d'origine (JPEG/PNG) en secours.
import { dimensions, srcsetWebp } from "../lib/images";

interface Props {
  src: string;
  alt: string;
  /** Largeur d'affichage, ex. "(max-width: 640px) 100vw, 400px" */
  sizes: string;
  class?: string;
  loading?: "lazy" | "eager";
  /** Afficher l'image de remplacement si la photo est introuvable */
  fallback?: boolean;
}

const { src, alt, sizes, class: className, loading = "lazy", fallback = true } = Astro.props;
const dims   = await dimensions(src);
const srcset = await srcsetWebp(src);
const onerror = fallback ? "this.onerror=null;this.src='/projects/placeholder.svg'" : undefined;
---

{srcset ? (
  <picture>
    <source type="image/webp" srcset={srcset} sizes={sizes} />
    <img
      src={src}
      alt={alt}
      class={className}
      width={dims?.width}
      height={dims?.height}
      loading={loading}
      onerror={onerror}
    />
  </picture>
) : (
  <img
    src={src}
    alt={alt}
    class={className}
    width={dims?.width}
    height={dims?.height}
    loading={loading}
    onerror={onerror}
  />
)}
