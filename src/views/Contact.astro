---
import Base from "../layouts/Base.astro";
import { siteDe } from "../data/donnees";
import { t, langDe } from "../i18n/ui";
const lang = langDe(Astro.url.pathname);
const T = t(lang);
const site = siteDe(lang);
---

<Base title={`${T.navContact} — ${site.name}`} description={`${T.contactDescription} ${site.name}`}>

  <section class="pageHead">
    <h1>Contact</h1>
    <p class="lead">
      {T.contactLead}
    </p>
  </section>

  <div class="contactGrid">

    <!-- Email -->
    <a class="contactCard" href={`mailto:${site.email}`}>
      <div class="contactIcon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
      </div>
      <div>
        <div class="contactLabel">Email</div>
        <div class="contactValue">{site.email}</div>
      </div>
    </a>

    <!-- LinkedIn -->
    <a class="contactCard" href={site.links.linkedin} target="_blank" rel="noreferrer">
      <div class="contactIcon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect x="2" y="9" width="4" height="12"/>
          <circle cx="4" cy="4" r="2"/>
        </svg>
      </div>
      <div>
        <div class="contactLabel">LinkedIn</div>
        <div class="contactValue">Mattéo Pozzo di Borgo</div>
      </div>
    </a>

    <!-- GitHub -->
    <a class="contactCard" href={site.links.github} target="_blank" rel="noreferrer">
      <div class="contactIcon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
        </svg>
      </div>
      <div>
        <div class="contactLabel">GitHub</div>
        <div class="contactValue">P0770</div>
      </div>
    </a>

    <!-- CV -->
    <a class="contactCard" href={site.cv} download>
      <div class="contactIcon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
      </div>
      <div>
        <div class="contactLabel">CV</div>
        <div class="contactValue">{T.cvValeur}</div>
      </div>
    </a>

    <!-- Localisation (pas un lien) -->
    <div class="contactCard contactCard--static">
      <div class="contactIcon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
      </div>
      <div>
        <div class="contactLabel">{T.baseA}</div>
        <div class="contactValue">{site.location} · {T.etudesGeneve}</div>
      </div>
    </div>

  </div>

</Base>
