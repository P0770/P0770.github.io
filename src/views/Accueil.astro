---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import DessinChassis from "../components/DessinChassis.astro";
import TypeBadge from "../components/TypeBadge.astro";
import { recents, siteDe } from "../data/donnees";
import { t, langDe, lien } from "../i18n/ui";

const lang = langDe(Astro.url.pathname);
const T = t(lang);
const site = siteDe(lang);
const projetsRecents = recents(lang);
// Projets mis en avant : ceux marqués « vedette: true » dans src/data/projects.ts
const vedettes = projetsRecents.filter((p) => p.vedette);
const latest = vedettes.length > 0 ? vedettes : projetsRecents.slice(0, 2);
const en = lang === "en";

// Projets en cours (bandeau « En ce moment ») et autres projets (mosaïque)
const enCours = projetsRecents.filter((p) => p.enCours);
const autres = projetsRecents.filter((p) => !latest.includes(p));
const court = (titre: string) => titre.split(" — ")[0];
---

<Base title={`${site.name} — Portfolio`} description={site.seo.description}>
  <div class="accueil">

    <section class="accueil-hero" aria-label="Introduction">
      <div>
        <h1 class="accueil-nom">
          <span>Mattéo</span>
          <span class="accueil-nomFin">Pozzo di Borgo</span>
        </h1>
        <p class="accueil-role">{T.role}</p>
        <div class="accueil-texte">
          <p>{T.intro1}</p>
          <p>{T.intro2}</p>
        </div>
        <div class="accueil-actions">
          <a class="btn btn-primary" href={lien(lang, "/projects")}>{T.voirProjets}</a>
          <a class="btn" href={lien(lang, "/about")}>{T.navApropos}</a>
          <a class="btn" href={site.cv} download>{T.telechargerCv}</a>
        </div>
      </div>
      <DessinChassis />
    </section>

    <section class="moi" aria-labelledby="moi-titre">
      <figure class="moi-photo">
        <Img src="/me.jpg" alt={T.portraitAlt} sizes="(max-width: 860px) 100vw, 420px" fallback={false} />
      </figure>
      <div class="moi-texte">
        <h2 id="moi-titre">{T.moiTitre}</h2>
        <p class="moi-accroche">{T.moiTexte}</p>
        <p class="moi-langues">{T.portraitTexte}</p>
        <a class="moi-lien" href={lien(lang, "/about")}>{T.moiLien}</a>
      </div>
    </section>

    {enCours.length > 0 && (
      <section class="maintenant" aria-labelledby="maintenant-titre">
        <h2 id="maintenant-titre" class="maintenant-titre">
          <span class="maintenant-pastille" aria-hidden="true"></span>{T.enCeMoment}
        </h2>
        <ul class="maintenant-liste">
          {enCours.map((p) => (
            <li>
              <a class="maintenant-projet" href={lien(lang, `/projects/${p.slug}`)}>
                <span class="maintenant-vignette">
                  <Img src={p.cover?.src ?? "/projects/placeholder.svg"} alt="" sizes="48px" />
                </span>
                <span class="maintenant-texte">
                  <span class="maintenant-nom">{court(p.title)}</span>
                  <span class="maintenant-periode">{p.periode}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="phares" aria-labelledby="phares-titre">
      <div class="phares-tete">
        <h2 id="phares-titre">{T.projetsPhares}</h2>
        <a href={lien(lang, "/projects")}>{T.touteChronologie}</a>
      </div>
      {latest.map((p) => (
        <a class="phare" href={lien(lang, `/projects/${p.slug}`)}>
          <div class="phare-img reperes" style={`view-transition-name: img-${p.slug}`}>
            <Img src={p.cover?.src ?? "/projects/placeholder.svg"} alt={p.cover?.alt ?? p.title} sizes="(max-width: 860px) 100vw, 640px" />
          </div>
          <div>
            <div class="phare-meta">
              <TypeBadge project={p} />
              <span>{p.periode}</span>
            </div>
            <h3>{p.title}</h3>
            <p>{p.subtitle}</p>
            <span class="phare-voir">{T.decouvrir}</span>
          </div>
        </a>
      ))}
    </section>

    {autres.length > 0 && (
      <section class="autres" aria-labelledby="autres-titre">
        <div class="phares-tete">
          <h2 id="autres-titre">{T.autresProjets}</h2>
          <a href={lien(lang, "/projects")}>{T.touteChronologie}</a>
        </div>
        <div class="autres-grille">
          {autres.map((p) => (
            <a class="autre" href={lien(lang, `/projects/${p.slug}`)}>
              <div class="autre-img reperes" style={`view-transition-name: img-${p.slug}`}>
                <Img src={p.cover?.src ?? "/projects/placeholder.svg"} alt={p.cover?.alt ?? p.title} sizes="(max-width: 860px) 50vw, 300px" />
              </div>
              <div class="phare-meta autre-meta">
                <TypeBadge project={p} />
                <span>{p.periode}</span>
              </div>
              <h3>{court(p.title)}</h3>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</Base>
