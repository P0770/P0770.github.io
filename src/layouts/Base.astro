---
import "@fontsource-variable/archivo/standard.css";
import "../styles/global.css";
import "../styles/refonte.css";
import Header from "../components/Header.astro";
import { site } from "../data/site";
import { t, langDe, autreLangue } from "../i18n/ui";

const {
  title = `${site.name} — Portfolio`,
  description = site.seo.description,
} = Astro.props;

const lang = langDe(Astro.url.pathname);
const T = t(lang);
const canonical = new URL(Astro.url.pathname, site.seo.url).toString();
const alternate = new URL(autreLangue(Astro.url.pathname), site.seo.url).toString();
const urlFr = lang === "fr" ? canonical : alternate;
const urlEn = lang === "en" ? canonical : alternate;
// Image d'aperçu affichée quand on partage un lien du site (LinkedIn, WhatsApp…)
const ogImage = new URL("/og-image.png", site.seo.url).toString();

// Fiche « Person » lisible par Google (page d'accueil uniquement) :
// aide à associer ton nom à ce site, LinkedIn et GitHub dans les résultats de recherche.
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "/en/";
const personne = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: new URL("/", site.seo.url).toString(),
  image: new URL("/me.jpg", site.seo.url).toString(),
  email: `mailto:${site.email}`,
  jobTitle: "Étudiant en ingénierie microtechnique (spécialisation biomédicale)",
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "HEPIA — Haute école du paysage, d'ingénierie et d'architecture de Genève (HES-SO)",
    url: "https://www.hesge.ch/hepia/",
  },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "Université de Liège" },
    { "@type": "EducationalOrganization", name: "CPNV — Centre professionnel du Nord vaudois" },
  ],
  address: { "@type": "PostalAddress", addressLocality: "Lausanne", addressCountry: "CH" },
  knowsLanguage: ["fr", "en", "it", "de"],
  sameAs: [site.links.linkedin, site.links.github],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- Prévenir le flash de thème -->
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.setAttribute("data-theme", t);
      } catch(e) {}
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={urlFr} />
    <link rel="alternate" hreflang="en" href={urlEn} />
    <link rel="alternate" hreflang="x-default" href={urlFr} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0E7C66" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "en" ? "en_GB" : "fr_CH"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(personne)} />}
  </head>

  <body>
    <a class="skip" href="#content">{T.skip}</a>
    <Header currentPath={Astro.url.pathname} />

    <main id="content" class="wrap">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <div>© {new Date().getFullYear()} {site.name}</div>
        <div class="footer-links">
          <a href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
          <span class="dot">·</span>
          <a href={site.links.github} target="_blank" rel="noreferrer">GitHub</a>
          <span class="dot">·</span>
          <a href={`mailto:${site.email}`}>Email</a>
        </div>
      </div>
    </footer>
  </body>
</html>
